# Copie somente os nomes necessários para um arquivo local protegido no Rigel.
# Informe o caminho ao worker por --env-file; não versione a cópia preenchida.
M365_TENANT_ID=<CONFIGURAR_MANUALMENTE>
M365_CLIENT_ID=<CONFIGURAR_MANUALMENTE>
M365_CLIENT_SECRET=<CONFIGURAR_MANUALMENTE>
M365_DELEGATED_CLIENT_ID=<CONFIGURAR_MANUALMENTE>
M365_SENDER_UPN=<CONFIGURAR_MANUALMENTE>
ALERTAD_EMAIL_RECIPIENTS=<EMAIL_1>,<EMAIL_2>
ALERTAD_TEAMS_CHAT_ID=<CONFIGURAR_MANUALMENTE>
ALERTAD_TEAMS_CACHE_FILE=.auth_cache/teams_token_cache.bin
